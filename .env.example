# ── Sniper Terminal environment template ─────────────────────────────
# Copy to .env and adjust. Never commit a real .env.

NODE_ENV=development
APP_NAME="Sniper Terminal"
PORT=4000
# Origins allowed to open the WebSocket (comma separated)
CORS_ORIGINS=http://localhost:3000

# Persistence (strongly recommended). Without it everything is in memory.
DATABASE_URL=postgres://sniper:sniper@localhost:5432/sniper
# Optional: leader election so only one instance trades
REDIS_URL=redis://localhost:6379

# Auth. SESSION_SECRET ≥ 32 chars; ADMIN_PASSWORD required in production.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Optional read-only account
VIEWER_USERNAME=
VIEWER_PASSWORD=
# Set to true behind HTTPS
COOKIE_SECURE=false

# Market data: only the deterministic simulator ships enabled (see docs/providers.md)
MARKET_PROVIDER=simulated
SIM_SEED=1337
SIM_LAUNCH_EVERY_SEC=25
PAPER_STARTING_EQUITY=1000
PAPER_TX_FAILURE_RATE=0.03
TICK_MS=1000

# Solana JSON-RPC (server side only) for the RPC security provider
SOLANA_RPC_URL=

# Live trading is impossible unless this is true AND a live adapter is configured
LIVE_TRADING_ENABLED=false

# Hard limits — cannot be raised from the UI/API
HARD_MAX_POSITION_QUOTE=250
HARD_MAX_TRADE_ALLOCATION_PCT=10
HARD_MAX_TOTAL_EXPOSURE_PCT=60
HARD_MAX_DAILY_LOSS_PCT=20
HARD_MAX_DRAWDOWN_PCT=40
HARD_MAX_SLIPPAGE_PCT=8
HARD_MAX_PRICE_IMPACT_PCT=8
HARD_MAX_CONCURRENT_POSITIONS=10

SNAPSHOT_RETENTION_DAYS=14

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info

# ── web (Next.js) ──
# Where the Next.js server proxies /api (server side only)
API_INTERNAL_URL=http://localhost:4000
# Public WebSocket URL the browser connects to
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
