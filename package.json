{
  "name": "sniper-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @sniper/server --filter @sniper/web dev",
    "dev:server": "pnpm --filter @sniper/server dev",
    "dev:web": "pnpm --filter @sniper/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sniper/server db:generate",
    "db:migrate": "pnpm --filter @sniper/server db:migrate",
    "db:seed": "pnpm --filter @sniper/server db:seed"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
